# ---------- Database ----------
# Leave empty for local SQLite. In production use the Supabase *Session pooler* URI
# (Supabase → Project → Connect → Session pooler). Render can't reach the direct db.* host (IPv6 only).
DATABASE_URL=

# ---------- Security ----------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_EXPIRES_DAYS=7

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- Attachments (Supabase Storage) ----------
# Leave empty locally -> images are saved in backend/uploads/
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ticket-attachments

# ---------- Team sharing ----------
# Customers with the same work email domain see each other's tickets. Free providers (gmail, outlook...) never share.
# Extra domains to never group (comma-separated):
NO_SHARE_DOMAINS=

# ---------- First company agent (created on startup if missing) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Support Admin

# ---------- Team alerts (optional) ----------
# Slack → your workspace → Apps → Incoming Webhooks → Add to channel → copy the URL
SLACK_WEBHOOK_URL=
# Used for the "Open in console" button in alerts
CONSOLE_URL=https://resolvehq.vercel.app/company-portal

# Local testing only: adds demo customer@acme.com / agent@resolvehq.com (password demo1234)
SEED_DEMO=false
